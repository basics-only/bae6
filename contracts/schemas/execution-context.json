{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/basics-only/bae6-contracts/schemas/execution-context.json",
  "title": "ExecutionContext",
  "description": "The trusted context of one request (ADR-0022). The enforcement middleware builds it only from a verified bae6 token (ADR-0019). It is never read from public headers or request bodies.",
  "type": "object",
  "required": ["tenantId", "orgPath", "principalId", "principalType", "actorId", "requestId"],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "$ref": "identity-context.json#/$defs/slug" },
    "orgPath": { "$ref": "#/$defs/orgPath" },
    "principalId": {
      "description": "The initiating principal: the user or service the work is for.",
      "$ref": "principal.json#/$defs/principalId"
    },
    "principalType": { "$ref": "principal.json#/$defs/principalType" },
    "actorId": {
      "description": "The principal doing the work. Equals principalId when no one acts for anyone.",
      "$ref": "principal.json#/$defs/principalId"
    },
    "applicationId": { "$ref": "identity-context.json#/$defs/slug" },
    "sessionId": { "$ref": "#/$defs/sessionId" },
    "taskId": { "$ref": "delegation.json#/$defs/taskId" },
    "delegationId": { "$ref": "delegation.json#/$defs/delegationId" },
    "traceId": { "$ref": "#/$defs/traceId" },
    "requestId": { "$ref": "request-context.json#/$defs/requestId" },
    "costCenterId": {
      "description": "Assigned by an admin, never supplied by the caller.",
      "$ref": "identity-context.json#/$defs/slug"
    }
  },
  "dependentRequired": { "delegationId": ["taskId"] },
  "$defs": {
    "orgPath": {
      "description": "Org unit IDs from the tenant root to the principal's unit. Bounded by the tenant's depth cap (ADR-0018).",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "identity-context.json#/$defs/slug" }
    },
    "sessionId": { "type": "string", "pattern": "^ses_[0-9a-f]{32}$" },
    "traceId": { "description": "W3C trace ID.", "type": "string", "pattern": "^[0-9a-f]{32}$" }
  }
}

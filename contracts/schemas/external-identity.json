{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/basics-only/bae6-contracts/schemas/external-identity.json",
  "title": "ExternalIdentity",
  "description": "An identity-provider account linked to a principal (ADR-0021). Unique on providerConnectionId, issuer, subject and externalTenantId.",
  "type": "object",
  "required": ["id", "principalId", "providerConnectionId", "issuer", "subject", "lastVerifiedAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^xid_[0-9a-f]{32}$" },
    "principalId": { "$ref": "principal.json#/$defs/principalId" },
    "providerConnectionId": { "$ref": "identity-context.json#/$defs/slug" },
    "issuer": { "type": "string", "format": "uri", "maxLength": 512 },
    "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
    "externalTenantId": {
      "description": "The provider's tenant, for multitenant issuers such as Entra (`tid`).",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "externalObjectId": {
      "description": "The provider's stable object ID, such as Entra `oid`.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "lastVerifiedAt": { "type": "string", "format": "date-time" }
  }
}

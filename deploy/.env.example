# Local development only. Copy to deploy/.env and replace every value.
# Every value has a dev-only default in compose.yaml, so this file is optional.
# Use URL-safe characters only (letters, digits, - _ . ~): the passwords are embedded in
# postgres:// URIs. Passwords are applied when the database volume is first created; after
# changing one, run `make down` and remove the pgdata volume to reset.
POSTGRES_ADMIN_PASSWORD=change-me-admin
OPENFGA_DB_PASSWORD=change-me-openfga
AUTHN_DB_PASSWORD=change-me-authn
AUTHZ_DB_PASSWORD=change-me-authz
AI_DB_PASSWORD=change-me-ai
EMBED_DB_PASSWORD=change-me-embed
MCP_DB_PASSWORD=change-me-mcp
AGENT_DB_PASSWORD=change-me-agent
EVAL_DB_PASSWORD=change-me-eval

# Host-run tooling (make migrate, API integration tests); authz role, authz database.
BAE6_DATABASE_URL=postgres://authz:change-me-authz@localhost:5432/authz

{
  "name": "@bae6/authz-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/run-migrate.ts",
    "test": "tsx --test src/*.test.ts src/*/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:replicas": "tsx --test ../../tests/load/equivalence.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@openfga/sdk": "catalog:",
    "@openfga/syntax-transformer": "catalog:",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "jose": "catalog:",
    "pg": "catalog:"
  }
}
